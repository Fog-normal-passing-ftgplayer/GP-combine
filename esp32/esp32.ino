void lfbThumbs(int active) {
  int x = (240 - (NUM_PAGES*(THUMB_SIZE+THUMB_GAP) - THUMB_GAP)) / 2;
  for (int i = 0; i < NUM_PAGES; i++) {
    lfbRect(x, THUMB_Y, THUMB_SIZE, THUMB_SIZE,
            (i == active) ? COL_THUMB_ON : COL_THUMB_OFF);
    x += THUMB_SIZE + THUMB_GAP;
  }
}

// ---- text (3x5 font, scaled FONT_SCALE x) ----
void drawChar(int x, int y, char c, uint16_t color) {
  const uint8_t *g = FONT3X5[fontIndex(c)];
  for (int row = 0; row < 5; row++) {
    uint8_t bits = g[row];
    for (int col = 0; col < 3; col++) {
      // glyphs are stored with bit 2 = leftmost column
      if (bits & (1 << (2 - col))) {
        for (int dy = 0; dy < FONT_SCALE; dy++)
          for (int dx = 0; dx < FONT_SCALE; dx++)
            lfbSet(x + col * FONT_SCALE + dx, y + row * FONT_SCALE + dy, color);
      }
    }
  }
}

void drawText(int x, int y, const char *s, uint16_t color) {
  while (*s) {
    drawChar(x, y, *s++, color);
    x += 4 * FONT_SCALE;
  }
}

void drawTextCentered(int cx, int cy, const char *s, uint16_t color) {
  int w = (int)strlen(s) * 4 * FONT_SCALE - FONT_SCALE;
  drawText(cx - w / 2, cy - FONT_SCALE * 5 / 2 + 1, s, color);
}

// ASCII text at an arbitrary pixel scale (for big numbers)
void drawTextBig(int x, int y, const char *s, uint16_t color, int scale) {
  while (*s) {
    const uint8_t *g = FONT3X5[fontIndex(*s)];
    for (int row = 0; row < 5; row++)
      for (int col = 0; col < 3; col++)
        if (g[row] & (1 << (2 - col)))
          for (int dy = 0; dy < scale; dy++)
            for (int dx = 0; dx < scale; dx++)
              lfbSet(x + col * scale + dx, y + row * scale + dy, color);
    x += 4 * scale;
    s++;
  }
}

// 18650 discharge curve: voltage mV -> percent
int battPercent(uint16_t mv) {
  if (mv < 2800 || mv > 4600) return -1; // no valid battery reading
  static const int pts[11][2] = {
    {4200,100},{4100,95},{4000,85},{3900,75},{3800,62},
    {3700,48},{3600,33},{3500,20},{3400,10},{3300,4},{3000,0}
  };
  if (mv >= pts[0][0]) return 100;
  if (mv <= pts[10][0]) return 0;
  for (int i = 0; i < 10; i++) {
    if (mv <= pts[i][0] && mv > pts[i + 1][0]) {
      return pts[i + 1][1] + (pts[i][1] - pts[i + 1][1]) *
             (mv - pts[i + 1][0]) / (pts[i][0] - pts[i + 1][0]);
    }
  }
  return 0;
}

// ---- shapes ----
void drawDisc(int cx, int cy, int r, uint16_t color) {
  for (int dy = -r; dy <= r; dy++)
    for (int dx = -r; dx <= r; dx++)
      if (dx*dx + dy*dy <= r*r) lfbSet(cx + dx, cy + dy, color);
}

void drawRing(int cx, int cy, int r, uint16_t color) {
  int inner = (r - 2) * (r - 2);
  for (int dy = -r; dy <= r; dy++)
    for (int dx = -r; dx <= r; dx++) {
      int d2 = dx*dx + dy*dy;
      if (d2 <= r*r && d2 >= inner) lfbSet(cx + dx, cy + dy, color);
    }
}

void drawBtn(int cx, int cy, int r, bool pressed, const char *label) {
  if (pressed) {
    drawDisc(cx, cy, r, COL_HI);
    drawTextCentered(cx, cy, label, COL_TEXT_ON);
  } else {
    drawRing(cx, cy, r, COL_RING);
    drawTextCentered(cx, cy, label, COL_RING);
  }
}

// layout transform: shrink the whole stick layout around the screen center
int lx(int x) { return 120 + (int)((x - 120) * layoutScale); }
int ly(int y) { return 70 + (int)((y - 70) * layoutScale); }
int lr(int r) { return (int)(r * layoutScale); }
void layoutBtn(int cx, int cy, int r, bool pressed, const char *label) {
  drawBtn(lx(cx), ly(cy), lr(r), pressed, label);
}

void layoutSquare(int x, int y, int size, bool pressed, const char *label) {
  int sx = lx(x), sy = ly(y), ss = lr(size);
  if (ss < 2) return;
  if (pressed) {
    lfbRect(sx, sy, ss, ss, COL_HI);
    drawTextCentered(sx + ss / 2, sy + ss / 2, label, COL_TEXT_ON);
  } else {
    for (int t = 0; t < 2; t++) {
      drawLine(sx + t, sy, sx + ss - 1, sy, COL_RING);
      drawLine(sx + t, sy + ss - 1, sx + ss - 1, sy + ss - 1, COL_RING);
      drawLine(sx, sy + t, sx, sy + ss - 1, COL_RING);
      drawLine(sx + ss - 1, sy + t, sx + ss - 1, sy + ss - 1, COL_RING);
    }
    drawTextCentered(sx + ss / 2, sy + ss / 2, label, COL_RING);
  }
}

// small battery indicator with fill proportional to pct
void drawMiniBattery(int x, int y, int w, int h, int pct, uint16_t color) {
  for (int t = 0; t < 2; t++) {
    drawLine(x + t, y, x + w, y, color);
    drawLine(x, y, x, y + h, color);
    drawLine(x + w, y, x + w, y + h, color);
    drawLine(x + t, y + h, x + w, y + h, color);
  }
  lfbRect(x + w, y + h / 3, 2, h / 3, color);      // terminal
  int fw = (w - 4) * pct / 100;
  if (fw > 0) lfbRect(x + 2, y + 2, fw, h - 4, ACC_BATTERY);
}

// small USB trident icon
void drawUsbIcon(int x, int y, uint16_t color) {
  drawLine(x + 3, y - 5, x + 3, y - 1, color);
  drawLine(x + 8, y - 5, x + 8, y - 1, color);
  drawLine(x + 13, y - 5, x + 13, y - 1, color);
  drawLine(x - 2, y - 1, x + 18, y - 1, color);    // crossbar
  drawLine(x + 8, y - 1, x + 8, y + 3, color);     // stem
  drawLine(x + 2, y + 3, x + 14, y + 3, color);    // base
  drawLine(x + 4, y + 6, x + 8, y + 8, color);
  drawLine(x + 8, y + 8, x + 12, y + 6, color);
  drawLine(x + 8, y + 3, x + 8, y + 8, color);
}

// tiny WiFi-style icon for the status bar (dot + arcs fanning upward)
void drawMiniWireless(int x, int y, bool linked) {
  uint16_t c = linked ? ACC_SETTINGS : RGB565(70,78,92);
  drawDisc(x, y, 2, c);
