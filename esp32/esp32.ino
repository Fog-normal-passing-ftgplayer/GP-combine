void drawOptValue(const MenuOpt *o, int rightX, int y, uint16_t color) {
  char buf[24];
  const char *s;
  if (o->type == OPT_ACTION) {
    drawCJKText(rightX - 8, y, ">", color, 1);
    return;
  } else if (o->type == OPT_ENUM) {
    int i = o->value - o->min;
    s = (i >= 0 && i < o->nameCount) ? o->names[i] : "?";
    drawCJKText(rightX - cjkTextWidth(s, 1), y, s, color, 1);
  } else if (o->type == OPT_BOOL) {
    s = o->value ? "开启" : "关闭";
    drawCJKText(rightX - cjkTextWidth(s, 1), y, s, color, 1);
  } else {
    snprintf(buf, sizeof(buf), "%d%s", o->value, o->unit);
    drawCJKText(rightX - cjkTextWidth(buf, 1), y, buf, color, 1);
  }
}

void stepValue(MenuOpt *o, int dir) {
  int16_t v = o->value + dir * ((o->type == OPT_INT) ? o->step : 1);
  if (v < o->min) v = o->min;
  if (v > o->max) v = o->max;
  if (v != o->value) {
    o->value = v;
    subDirty = true;
    redrawNeeded = true;
  }
}

// keep the selected row visible, scrolling the list if needed
void clampScroll(int sel, int count, int visible, int &scroll) {
  if (count <= visible) { scroll = 0; return; }
  if (sel < scroll) scroll = sel;
  if (sel >= scroll + visible) scroll = sel - visible + 1;
  if (scroll > count - visible) scroll = count - visible;
}

// ease the selection highlight and list offset toward their targets
void startListAnim(int selIdx, int scrollIdx, int rowH) {
  selYFrom = selY;
  selYTo = (float)selIdx * rowH;
  scrollFrom = scrollOff;
  scrollTo = (float)scrollIdx * rowH;
  listAnimStart = millis();
  listAnimating = true;
}

void updateListAnim() {
  float t = (float)(millis() - listAnimStart) / LIST_ANIM_MS;
  if (t >= 1.0f) {
    selY = selYTo;
    scrollOff = scrollTo;
    listAnimating = false;
    redrawNeeded = true;
    return;
  }
  float e = 1.0f - (1.0f-t)*(1.0f-t)*(1.0f-t); // ease-out cubic
  selY = selYFrom + (selYTo - selYFrom) * e;
  scrollOff = scrollFrom + (scrollTo - scrollFrom) * e;
  redrawNeeded = true;
}

void drawScrollbar(int count, float off, int visible, int rowH, int x, int y0, int y1) {
  if (count <= visible) return;
  int trackH = y1 - y0;
  int thumbH = trackH * visible / count;
  if (thumbH < 8) thumbH = 8;
  float range = (float)((count - visible) * rowH);
  int thumbY = y0 + (range > 0 ? (int)(off / range * (trackH - thumbH)) : 0);
  lfbRect(x, y0, 3, trackH, RGB565(58,66,80));
  lfbRect(x, thumbY, 3, thumbH, ACC_SETTINGS);
}

// horizontal slider: value 0..max, thumb position proportional
void drawSlider(int x, int y, int w, int value, int max, uint16_t color) {
  int trackY = y + 7;
  lfbRect(x, trackY, w, 3, RGB565(58,66,80));          // track
  int thumbX = x + (w - 4) * value / max;
  if (thumbX > x) lfbRect(x, trackY, thumbX - x + 2, 3, color); // filled
  drawDisc(thumbX + 2, trackY + 1, 4, color);          // thumb
}

void snapshotOpts() {
  SubPageDef &def = subDefs[subPage];
  if (def.sectionCount == 0) return;
  MenuSection &sec = def.sections[subSection];
  for (int i = 0; i < sec.count && i < MAX_SUB_OPTS; i++) optSnap[i] = sec.opts[i].value;
}

void restoreOpts() {
  SubPageDef &def = subDefs[subPage];
  if (def.sectionCount == 0) return;
  MenuSection &sec = def.sections[subSection];
  for (int i = 0; i < sec.count && i < MAX_SUB_OPTS; i++) sec.opts[i].value = optSnap[i];
  if (subPage == 3) applyBgSettings(); // 背景: re-apply reverted values
  if (subPage == 0 && subSection == 1) applyHistSettings(); // 设置 > 显示
  if (subPage == 5) applyWirelessSettings(); // 无线
  redrawNeeded = true;
}

// go back one level (option list -> section list/menu)
void subBack() {
  SubPageDef &def = subDefs[subPage];
  if (subList || def.sectionCount <= 1) {
    view = VIEW_MENU;
    page = 0; // reset menu cursor to the first page
  } else {
    subList = true;
    subSection = 0; // reset section cursor to the first section
    secScroll = 0;
    selY = 0;
    scrollOff = 0;
    listAnimating = false;
  }
  redrawNeeded = true;
}

// ---- ESP32 本机设置持久化：LittleFS 配置文件（不依赖 NVS） ----
// 保存时把全部 ESP32 侧设置写成一个简单文本配置文件；
// 上电时先读取并应用，避免板上旧 NVS 数据导致的保存失败。

void applyBgSettings() {
  rotSwapRow = bgOpts[2].value ? 0 : 1;    // 水平翻转
  rotRevCol = bgOpts[3].value ? 0 : 1;     // 垂直翻转
  invertScreen = bgOpts[4].value != 0;     // 反色
  ledcWrite(BL, (uint32_t)bgOpts[1].value * 255 / 100); // 背光 PWM
  redrawNeeded = true;
}

void saveBgSettings() {
  saveConfigFile();
}

void saveHistSettings() {
  saveConfigFile();
}

// ---- input history toggle (settings > 显示) ----
void applyHistSettings() {
  layoutScale = histOpts[0].value ? 0.78f : 1.0f; // shrink layout for the strip
  redrawNeeded = true;
}

// ---- wireless settings (nRF24 on the ESP32) ----
void applyWirelessSettings() {
  radioUp = wlOpts[0].value != 0;
  static const int hb[] = {50, 20, 10};
  radioHeartbeatMs = hb[wlOpts[4].value];
  if (radioUp) {
    radio.powerUp();
    radio.setChannel((uint8_t)wlOpts[1].value);
    radio.setRfConfig(wlOpts[3].value == 0, (uint8_t)wlOpts[2].value);
  } else {
    radio.powerDown();
  }
  redrawNeeded = true;
}

void saveWirelessSettings() {
  saveConfigFile();
}

void saveConfigFile() {
  File f = LittleFS.open("/gpfusion.cfg", "w");
  if (!f) return;
  f.printf("hist=%d\n", histOpts[0].value);
  f.printf("layout=%d\n", histOpts[1].value);
  f.printf("bg_level=%d\n", bgOpts[0].value);
  f.printf("bl=%d\n", bgOpts[1].value);
  f.printf("hflip=%d\n", bgOpts[2].value);
  f.printf("vflip=%d\n", bgOpts[3].value);
  f.printf("inv=%d\n", bgOpts[4].value);
  f.printf("wl_on=%d\n", wlOpts[0].value);
  f.printf("wl_ch=%d\n", wlOpts[1].value);
  f.printf("wl_pwr=%d\n", wlOpts[2].value);
  f.printf("wl_rate=%d\n", wlOpts[3].value);
  f.printf("wl_hb=%d\n", wlOpts[4].value);
  f.flush();
  f.close();
}

void loadConfigFile() {
  if (!LittleFS.exists("/gpfusion.cfg")) return;
  File f = LittleFS.open("/gpfusion.cfg", "r");
  if (!f) return;
  while (f.available()) {
    String line = f.readStringUntil('\n');
    line.trim();
    int eq = line.indexOf('=');
    if (eq <= 0) continue;
    String k = line.substring(0, eq);
    int v = line.substring(eq + 1).toInt();
    if (k == "hist")      histOpts[0].value = constrain(v, 0, 1);
    else if (k == "layout") histOpts[1].value = constrain(v, 0, 3);
    else if (k == "bg_level") bgOpts[0].value = constrain(v, 0, 4);
    else if (k == "bl")   bgOpts[1].value = constrain(v, 0, 100);
    else if (k == "hflip") bgOpts[2].value = constrain(v, 0, 1);
    else if (k == "vflip") bgOpts[3].value = constrain(v, 0, 1);
    else if (k == "inv")  bgOpts[4].value = constrain(v, 0, 1);
    else if (k == "wl_on") wlOpts[0].value = constrain(v, 0, 1);
    else if (k == "wl_ch") wlOpts[1].value = constrain(v, 0, 125);
    else if (k == "wl_pwr") wlOpts[2].value = constrain(v, 0, 3);
    else if (k == "wl_rate") wlOpts[3].value = constrain(v, 0, 1);
    else if (k == "wl_hb") wlOpts[4].value = constrain(v, 0, 2);
  }
  f.close();
  applyBgSettings();
  applyHistSettings();
  applyWirelessSettings();
}

void renderScene(int16_t outX, int16_t inX) {
  if (view == VIEW_LAYOUT) {
    memcpy(lfb, BACKGROUND_IMG[bgOpts[0].value], 240 * 135 * 2);
    drawStatusBar();
    drawButtonLayout();
    drawInputHistory();
  } else if (view == VIEW_SUB) {
    renderSub();
  } else {
    lfbFill(COL_BG);
    drawPageContent(outX, page);
    drawPageContent(inX, (page + animDir + NUM_PAGES) % NUM_PAGES);
    lfbThumbs(page);
  }
}

void pushFrame() {
  uint8_t *out = rbuf;
  for (int my = 0; my < 240; my++) {
    for (int mx = 0; mx < 135; mx++) {
      int cx = rotSwapRow ? my : (239 - my);
      int cy = rotRevCol ? (134 - mx) : mx;
      uint16_t c = lfb[cy * 240 + cx];
      if (invertScreen) c = 0xFFFF - c;
      *out++ = (uint8_t)(c >> 8);
      *out++ = (uint8_t)(c & 0xFF);
    }
  }
  setWin(0, 0, 134, 239);
  digitalWrite(DC, HIGH);   // data mode for the bulk transfer
  digitalWrite(CS, LOW);
  SPI.transfer(rbuf, sizeof(rbuf));
  digitalWrite(CS, HIGH);
}

void drawPage() {
  renderScene(ICON_X, -ICON_W); // static page: incoming slot off-screen
  pushFrame();
}

void menuMove(int dir) {
  if (animating) { pendingDir = dir; return; }
  animDir = dir;
  animStart = millis();
  animating = true;
}

void updateAnimation() {
  unsigned long now = millis();
  if (now - lastFrameTime < FRAME_MS) return;
  lastFrameTime = now;
  float t = (float)(now - animStart) / ANIM_MS;
  if (t >= 1.0f) {
    animating = false;
    page = (page + animDir + NUM_PAGES) % NUM_PAGES;
    drawPage();
    if (pendingDir) {
      int d = pendingDir;
      pendingDir = 0;
      menuMove(d);
    }
    return;
  }
  // ease-out cubic
  float e = 1.0f - (1.0f-t)*(1.0f-t)*(1.0f-t);
  int off = (int)(240.0f * e);
  int16_t outX = ICON_X + animDir * (-off);
  int16_t inX  = ICON_X + animDir * (240 - off);

  renderScene(outX, inX);
  pushFrame();
}

// ---- CRC-16/CCITT-FALSE (poly 0x1021, init 0xFFFF) ----
static uint16_t crc16_update(uint16_t crc, uint8_t b) {
  crc ^= (uint16_t)b << 8;
  for (int i = 0; i < 8; i++) {
    crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021) : (uint16_t)(crc << 1);
  }
  return crc;
}

// RX state machine
uint8_t rxState = 0; // 0 idle, 1 ver, 2 type, 3 len, 4 payload, 5 crcLo, 6 crcHi
uint8_t rxType = 0;
uint8_t rxLen = 0;
uint8_t rxIdx = 0;
uint8_t rxPayload[24];
uint16_t rxCrcCalc = 0;
uint8_t rxCrcLo = 0;

void sendAck() {
  uint8_t frame[7];
  frame[0] = FRAME_MAGIC;
  frame[1] = FRAME_VERSION;
  frame[2] = FRAME_TYPE_ACK;
  frame[3] = 1;
  frame[4] = 0x01;
  uint16_t crc = 0xFFFF;
  for (int i = 1; i <= 4; i++) crc = crc16_update(crc, frame[i]);
  frame[5] = (uint8_t)(crc & 0xFF);
  frame[6] = (uint8_t)(crc >> 8);
  Serial.write(frame, sizeof(frame));
}

// push the 手柄 (gamepad) section values to the Pico
void sendGamepadConfig() {
  uint8_t frame[11];
  frame[0] = FRAME_MAGIC;
  frame[1] = FRAME_VERSION;
  frame[2] = FRAME_TYPE_CONFIG;
  frame[3] = 5;
  frame[4] = (uint8_t)gpOpts[0].value; // inputMode
  frame[5] = (uint8_t)gpOpts[1].value; // socdMode
  frame[6] = (uint8_t)gpOpts[2].value; // dpadMode
  frame[7] = (gpOpts[3].value ? 0x01 : 0) |
             (gpOpts[4].value ? 0x02 : 0) |
             (gpOpts[5].value ? 0x04 : 0); // fourWay / invertX / invertY
  frame[8] = (uint8_t)gpOpts[6].value;    // debounceDelay
  uint16_t crc = 0xFFFF;
  for (int i = 1; i <= 8; i++) crc = crc16_update(crc, frame[i]);
  frame[9] = (uint8_t)(crc & 0xFF);
  frame[10] = (uint8_t)(crc >> 8);
  Serial.write(frame, sizeof(frame));
  lastConfigSent = millis();
  configAcked = false;
}

// push the 灯光 (LED) section values to the Pico
void sendLedConfig() {
  uint8_t frame[16];
  frame[0] = FRAME_MAGIC;
  frame[1] = FRAME_VERSION;
  frame[2] = FRAME_TYPE_LED;
  frame[3] = 10;
  frame[4] = (uint8_t)ledOpts[0].value; // baseAnimationIndex
  frame[5] = (uint8_t)ledOpts[1].value; // brightness
  frame[6] = (uint8_t)ledOpts[2].value; // staticColorIndex
  frame[7] = ledOpts[6].value ? 0x01 : 0; // turnOffWhenSuspended
  uint16_t ch = (uint16_t)((100 - ledOpts[3].value) * 10 + 1);
  frame[8] = (uint8_t)(ch & 0xFF);
  frame[9] = (uint8_t)(ch >> 8);
  uint16_t rb = (uint16_t)((100 - ledOpts[4].value) * 10 + 1);
  frame[10] = (uint8_t)(rb & 0xFF);
  frame[11] = (uint8_t)(rb >> 8);
  uint16_t fl = (uint16_t)((100 - ledOpts[5].value) * 10 + 1);
  frame[12] = (uint8_t)(fl & 0xFF);
  frame[13] = (uint8_t)(fl >> 8);
  uint16_t crc = 0xFFFF;
  for (int i = 1; i <= 13; i++) crc = crc16_update(crc, frame[i]);
  frame[14] = (uint8_t)(crc & 0xFF);
  frame[15] = (uint8_t)(crc >> 8);
  Serial.write(frame, sizeof(frame));
  lastConfigSent = millis();
  configAcked = false;
}

void onInputFrame(uint8_t *payload, uint8_t len) {
  if (len >= 3) {
    uint16_t buttons = payload[0] | ((uint16_t)payload[1] << 8);
    uint8_t dpad = payload[2];
    uint16_t bEdge = buttons & ~lastButtons;
    uint8_t dEdge = dpad & ~lastDpad;
    bool inputChanged = (buttons != lastButtons || dpad != lastDpad);
    if (len >= 13) { // full state: sticks + triggers
      lastLX = payload[3] | ((uint16_t)payload[4] << 8);
      lastLY = payload[5] | ((uint16_t)payload[6] << 8);
      lastRX = payload[7] | ((uint16_t)payload[8] << 8);
      lastRY = payload[9] | ((uint16_t)payload[10] << 8);
      lastLT = payload[11];
      lastRT = payload[12];
    }

    // record input history edges
    if (dEdge & 0x01) pushHist("U");
    if (dEdge & 0x02) pushHist("D");
    if (dEdge & 0x04) pushHist("L");
    if (dEdge & 0x08) pushHist("R");
    if (bEdge & 0x0001) pushHist("1");
    if (bEdge & 0x0002) pushHist("2");
    if (bEdge & 0x0004) pushHist("3");
    if (bEdge & 0x0008) pushHist("4");
    if (bEdge & 0x0010) pushHist("L1");
    if (bEdge & 0x0020) pushHist("R1");
    if (bEdge & 0x0040) pushHist("L2");
    if (bEdge & 0x0080) pushHist("R2");
    if (bEdge & 0x0100) pushHist("S1");
    if (bEdge & 0x0200) pushHist("S2");
    if (bEdge & 0x0400) pushHist("L3");
    if (bEdge & 0x0800) pushHist("R3");
    if (bEdge & 0x1000) pushHist("A1");
    if (bEdge & 0x2000) pushHist("A2");

    if (view == VIEW_MENU) {
      if (dEdge & 0x04) menuMove(-1); // DPAD LEFT
      if (dEdge & 0x08) menuMove(+1); // DPAD RIGHT
      if (bEdge & 0x01) { // B1 / A = enter sub-page
        view = VIEW_SUB;
        subPage = page;
        subSel = 0;
        subSection = 0;
        subList = (subDefs[subPage].sectionCount > 1);
        subScroll = 0;
        secScroll = 0;
        selY = 0; scrollOff = 0;
        listAnimating = false;
        sliderMode = false;
        if (!subList) { // straight into the option list (single-section page)
          snapshotOpts();
          subDirty = false;
        }
        lastStepTime = millis();
        animating = false;
        pendingDir = 0;
        redrawNeeded = true;
      }
      if (bEdge & 0x02) { // B2 / B = cancel -> back to layout
        view = VIEW_LAYOUT;
        animating = false;
        pendingDir = 0;
        redrawNeeded = true;
      }
      s2PressStart = 0;
    } else if (view == VIEW_SUB) {
      SubPageDef &def = subDefs[subPage];
      unsigned long nowMs = millis();
      if (confirmOpen) { // save-confirm dialog
        if (dEdge & 0x0C) { // LEFT/RIGHT toggles 是/否
          confirmChoice = 1 - confirmChoice;
          redrawNeeded = true;
        }
        if (bEdge & 0x01) { // A confirms
          bool yes = (confirmChoice == 0);
          confirmOpen = false;
          if (yes) {
            if (subPage == 0 && subSection == 0) sendGamepadConfig(); // 设置 > 手柄
            else if (subPage == 2) sendLedConfig();                   // 灯光 > 彩灯
            else if (subPage == 3) saveBgSettings();                  // 背景 > NVS
            else if (subPage == 0 && subSection == 1) saveHistSettings(); // 设置 > 显示
            else if (subPage == 5) saveWirelessSettings();            // 无线 > NVS
            savedFlashUntil = millis() + 1200;
            snapshotOpts();
          } else {
            restoreOpts();
          }
          subDirty = false;
          subBack();
        }
        if (bEdge & 0x02) { // B = 否
          confirmOpen = false;
          restoreOpts();
          subDirty = false;
          subBack();
        }
      } else if (def.sectionCount > 0) {
        if (subList) { // section list: up/down select, A enter, B back to menu
          uint8_t heldD = dpad & 0x03;
          if (heldD && (dEdge & 0x03 || nowMs - lastStepTime >= 250)) {
            if (heldD & 0x01) subSection = (subSection + def.sectionCount - 1) % def.sectionCount;
            if (heldD & 0x02) subSection = (subSection + 1) % def.sectionCount;
            clampScroll(subSection, def.sectionCount, 3, secScroll);
            startListAnim(subSection, secScroll, 30);
            lastStepTime = nowMs;
            redrawNeeded = true;
          }
          if (!heldD) lastStepTime = 0;
          if (bEdge & 0x01) { // A = enter section
            subList = false;
            subSel = 0;
            subScroll = 0;
            selY = 0; scrollOff = 0;
            listAnimating = false;
            sliderMode = false;
            snapshotOpts();
            subDirty = false;
            lastStepTime = millis();
            redrawNeeded = true;
          }
          if (bEdge & 0x02) subBack(); // B = back to menu
        } else { // option list: up/down select, left/right change, A action, B back
          MenuSection &sec = def.sections[subSection];
          if (sliderMode) { // A entered a slider: left/right adjusts, B exits
            MenuOpt *so = &sec.opts[sliderIdx];
            uint8_t heldLR = dpad & 0x0C;
            if (heldLR && (dEdge & 0x0C || nowMs - lastStepTime >= 120)) {
              if (heldLR & 0x04) stepValue(so, -1);
              if (heldLR & 0x08) stepValue(so, +1);
              if (subPage == 3) applyBgSettings();
              else if (subPage == 0 && subSection == 1) applyHistSettings();
              else if (subPage == 5) applyWirelessSettings();
              lastStepTime = nowMs;
            }
            if (!heldLR) lastStepTime = 0;
            if (bEdge & 0x02) { // B exits slider mode
              sliderMode = false;
              redrawNeeded = true;
            }
          } else {
            uint8_t heldD = dpad & 0x03; // UP/DOWN
            if (heldD && (dEdge & 0x03 || nowMs - lastStepTime >= 250)) {
              if (heldD & 0x01) subSel = (subSel + sec.count - 1) % sec.count;
              if (heldD & 0x02) subSel = (subSel + 1) % sec.count;
              clampScroll(subSel, sec.count, 4, subScroll);
              startListAnim(subSel, subScroll, 24);
              lastStepTime = nowMs;
              redrawNeeded = true;
            }
            MenuOpt *o = &sec.opts[subSel];
            uint8_t heldLR = dpad & 0x0C; // LEFT/RIGHT (not for sliders)
            if (heldLR && o->type != OPT_SLIDER &&
                (dEdge & 0x0C || nowMs - lastStepTime >= 250)) {
              if (heldLR & 0x04) stepValue(o, -1);
              if (heldLR & 0x08) stepValue(o, +1);
              if (subPage == 3) applyBgSettings();
              else if (subPage == 0 && subSection == 1) applyHistSettings();
              else if (subPage == 5) applyWirelessSettings();
              lastStepTime = nowMs;
            }
            if (!heldD && !heldLR) lastStepTime = 0;
            if (bEdge & 0x01) { // A
              if (o->type == OPT_SLIDER) { // enter slider mode
                sliderMode = true;
                sliderIdx = subSel;
                lastStepTime = millis();
                redrawNeeded = true;
              } else if (o->type == OPT_ACTION) {
                if (subPage == 0 && subSection == 2 && subSel == 1) { // 系统 > 保存设置
                  sendGamepadConfig();
                  sendLedConfig();
                  saveBgSettings();
                  saveHistSettings();
                  saveWirelessSettings();
                  savedFlashUntil = millis() + 1200;
                  snapshotOpts();
                  subDirty = false;
                  redrawNeeded = true;
                }
                else if (subPage == 5 && subSel == 5) { // 无线 > 重新配对
                  radio.resetLink();
                  savedFlashUntil = millis() + 1200;
                }
              }
            }
            if (bEdge & 0x02) { // B = back one level, confirm save if dirty
              if (subDirty) {
                confirmOpen = true;
                confirmChoice = 0;
                redrawNeeded = true;
              } else {
                subBack();
              }
            }
          }
        }
      }
      if (def.sectionCount == 0 && (bEdge & 0x02)) { // placeholder page: B back
        view = VIEW_MENU;
        redrawNeeded = true;
      }
      s2PressStart = 0;
    } else { // VIEW_LAYOUT
      bool s2Held = (buttons & 0x0200) != 0;
      if (s2Held && !s2WasHeld) s2PressStart = millis();
      if (!s2Held) s2PressStart = 0;
      s2WasHeld = s2Held;
      if (s2PressStart && millis() - s2PressStart >= 3000) {
        s2PressStart = 0;
        view = VIEW_MENU;
        redrawNeeded = true;
      }
      if (inputChanged) redrawNeeded = true;
    }
    lastButtons = buttons;
    lastDpad = dpad;
  }
  lastActivity = millis();
  sendAck();
}

void onStatusFrame(uint8_t *payload, uint8_t len) {
  if (len >= 18) {
    stSocd = payload[0];
    stDpadMode = payload[1];
    stInputMode = payload[2];
    stFlags = payload[3];
    uint8_t anim = payload[5];
    uint8_t brightness = payload[6];
    uint8_t staticColor = payload[7];
    uint16_t chase = payload[8] | ((uint16_t)payload[9] << 8);
    uint16_t rainbow = payload[10] | ((uint16_t)payload[11] << 8);
    uint8_t ledFlags = payload[12];
    uint16_t flow = payload[13] | ((uint16_t)payload[14] << 8);
    stBattMv = payload[15] | ((uint16_t)payload[16] << 8);
    stBattFlags = payload[17];
    // sync the gamepad menu values with the Pico's real config,
    // but never overwrite staged (unsaved) edits in the sub-menu
    bool editing = (view == VIEW_SUB && (subDirty || confirmOpen));
    if (!editing && millis() - lastConfigSent > 2000) {
      gpOpts[0].value = payload[2]; // inputMode
      gpOpts[1].value = payload[0]; // socdMode
      gpOpts[2].value = payload[1]; // dpadMode
      gpOpts[3].value = (payload[3] & 0x01) ? 1 : 0;
      gpOpts[4].value = (payload[3] & 0x02) ? 1 : 0;
      gpOpts[5].value = (payload[3] & 0x04) ? 1 : 0;
      gpOpts[6].value = payload[4]; // debounceDelay
      ledOpts[0].value = anim > 5 ? 5 : anim;
      ledOpts[1].value = brightness > 5 ? 5 : brightness;
      ledOpts[2].value = staticColor > 15 ? 15 : staticColor;
      int cv = 100 - ((int)chase - 1) / 10;
      ledOpts[3].value = cv < 0 ? 0 : (cv > 100 ? 100 : cv);
      int rv = 100 - ((int)rainbow - 1) / 10;
      ledOpts[4].value = rv < 0 ? 0 : (rv > 100 ? 100 : rv);
      int fv = 100 - ((int)flow - 1) / 10;
      ledOpts[5].value = fv < 0 ? 0 : (fv > 100 ? 100 : fv);
      ledOpts[6].value = (ledFlags & 0x01) ? 1 : 0;
    }
    redrawNeeded = true;
  }
}

void handleRxByte(uint8_t b) {
  switch (rxState) {
    case 0:
      if (b == FRAME_MAGIC) rxState = 1;
      break;
    case 1:
      rxCrcCalc = 0xFFFF;
      rxCrcCalc = crc16_update(rxCrcCalc, b);
      rxState = (b == FRAME_VERSION) ? 2 : 0;
      break;
    case 2:
      rxType = b;
      rxCrcCalc = crc16_update(rxCrcCalc, b);
      rxState = 3;
      break;
    case 3:
      rxLen = b;
      rxCrcCalc = crc16_update(rxCrcCalc, b);
      if (rxLen > sizeof(rxPayload)) { rxState = 0; break; }
      rxIdx = 0;
      rxState = (rxLen == 0) ? 5 : 4;
      break;
    case 4:
      rxPayload[rxIdx++] = b;
      rxCrcCalc = crc16_update(rxCrcCalc, b);
      if (rxIdx == rxLen) rxState = 5;
      break;
    case 5:
      rxCrcLo = b;
      rxState = 6;
      break;
    case 6:
      if (b == (uint8_t)(rxCrcCalc >> 8) &&
          rxCrcLo == (uint8_t)(rxCrcCalc & 0xFF)) {
        if (rxType == FRAME_TYPE_INPUT) onInputFrame(rxPayload, rxLen);
        else if (rxType == FRAME_TYPE_STATUS) onStatusFrame(rxPayload, rxLen);
        else if (rxType == FRAME_TYPE_CONFIG_ACK) {
          configAcked = true;
          savedFlashUntil = millis() + 1200;
        }
      }
      rxState = 0;
      break;
  }
}

void setup(){
  ledcAttach(BL, 5000, 8);
  ledcWrite(BL, 255);
  pinMode(CS,OUTPUT);pinMode(DC,OUTPUT);pinMode(RST,OUTPUT);digitalWrite(CS,HIGH);
  SPI.begin(12,-1,11,-1);SPI.setFrequency(40000000);
  digitalWrite(RST,LOW);delay(10);digitalWrite(RST,HIGH);delay(120);
  cmd(0x01);delay(150);cmd(0x11);delay(150);
  cmd(0x3A);dat(0x55);cmd(0x36);dat(0x00);cmd(0x21);cmd(0x13);delay(10);cmd(0x29);delay(10);
  drawPage();
  Serial.begin(UART_BAUD, SERIAL_8N1, ESP_RX, ESP_TX);
  pinMode(48,OUTPUT);
  digitalWrite(48, LOW);
  nrfSpi.begin(16, 18, 17, -1); // SCK, MISO, MOSI (CSN/CE managed by driver)
  radio.begin(nrfSpi, NRF_CSN, NRF_CE);
  radioUp = true;
  LittleFS.begin(true);   // 挂载文件系统（首次自动格式化）
  loadConfigFile();
}

void loop(){
  while (Serial.available()) {
    handleRxByte((uint8_t)Serial.read());
  }
  if (animating) updateAnimation();
  if (listAnimating) updateListAnim();
  if (savedFlashUntil && millis() >= savedFlashUntil) { // toast expired
    savedFlashUntil = 0;
    redrawNeeded = true;
  }
  // wireless: forward full gamepad state + mode over nRF24
  if (radioUp) {
    uint8_t pkt[15];
    pkt[0] = stInputMode;             // mode the receiver should adopt
    pkt[1] = radioSeq++;
    pkt[2] = lastButtons & 0xFF;
    pkt[3] = lastButtons >> 8;
    pkt[4] = lastDpad;
    pkt[5] = lastLX & 0xFF;  pkt[6] = lastLX >> 8;
    pkt[7] = lastLY & 0xFF;  pkt[8] = lastLY >> 8;
    pkt[9] = lastRX & 0xFF;  pkt[10] = lastRX >> 8;
    pkt[11] = lastRY & 0xFF; pkt[12] = lastRY >> 8;
    pkt[13] = lastLT;
    pkt[14] = lastRT;
    unsigned long now = millis();
    bool changed = memcmp(&pkt[2], radioPrevState, 13) != 0;
    if (changed || now - lastRadioSend >= (unsigned long)radioHeartbeatMs) {
      memcpy(radioPrevState, &pkt[2], 13);
      bool acked = radio.writePacket(pkt);
      if (radioHist[radioHistIdx]) radioHistOk--;
      radioHist[radioHistIdx] = acked ? 1 : 0;
      if (acked) radioHistOk++;
      radioHistIdx = (radioHistIdx + 1) % 100;
      radioLinked = (radioHistOk >= 40); // majority of the last 100 ACKed
      lastRadioSend = now;
    }
  }
  // refresh status bar / wireless page periodically (no input events needed)
  static unsigned long lastUiRefresh = 0;
  if (millis() - lastUiRefresh >= 1000) {
    lastUiRefresh = millis();
    redrawNeeded = true;
  }
  if (redrawNeeded && !animating) {
    redrawNeeded = false;
    renderScene(ICON_X, -ICON_W);
    pushFrame();
  }
  digitalWrite(48, (millis() - lastActivity < 250) ? HIGH : LOW);
}
