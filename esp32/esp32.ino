// ---- framebuffer helpers ----
inline void lfbSet(int x, int y, uint16_t c) {
  if (x >= 0 && x < 240 && y >= 0 && y < 135) lfb[y * 240 + x] = c;
}

// ---- Chinese font (16x16 1bpp, generated by cn_font_gen.py) ----
int cnFind(uint16_t cp) {
  int lo = 0, hi = CN_FONT_NUM - 1;
  while (lo <= hi) {
    int mid = (lo + hi) >> 1;
    if (CN_FONT_CODES[mid] == cp) return mid;
    if (CN_FONT_CODES[mid] < cp) lo = mid + 1; else hi = mid - 1;
  }
  return -1;
}

void drawCJKChar(int x, int y, uint16_t cp, uint16_t color, int scale) {
  int idx = cnFind(cp);
  if (idx < 0 || scale < 1) return;
  const uint8_t *g = CN_FONT_GLYPHS[idx];
  for (int row = 0; row < 16; row++) {
    for (int col = 0; col < 16; col++) {
      if ((g[row * 2 + col / 8] >> (7 - (col & 7))) & 1) {
        for (int dy = 0; dy < scale; dy++)
          for (int dx = 0; dx < scale; dx++)
            lfbSet(x + col * scale + dx, y + row * scale + dy, color);
      }
    }
  }
}

// draw a UTF-8 string: ASCII uses the 3x5 font, CJK uses the 16x16 font
void drawCJKText(int x, int y, const char *s, uint16_t color, int scale) {
  while (*s) {
    uint8_t c = (uint8_t)*s;
    if (c < 0x80) {
      drawChar(x, y + (16 * scale - 5 * FONT_SCALE) / 2, (char)c, color);
      x += 4 * FONT_SCALE;
      s++;
      continue;
    }
    uint16_t cp = 0;
    if ((c & 0xE0) == 0xC0) {
      cp = ((uint16_t)(c & 0x1F) << 6) | ((uint8_t)*++s & 0x3F);
      s++;
    } else if ((c & 0xF0) == 0xE0) {
      cp = ((uint16_t)(c & 0x0F) << 12) | (((uint8_t)*++s & 0x3F) << 6);
      cp |= ((uint8_t)*++s & 0x3F);
      s++;
    } else {
      s++;
      continue;
    }
    drawCJKChar(x, y, cp, color, scale);
    x += 16 * scale;
  }
}

int cjkTextWidth(const char *s, int scale) {
  int w = 0;
  while (*s) {
    uint8_t c = (uint8_t)*s;
    if (c < 0x80) { w += 4 * FONT_SCALE; s++; }
    else if ((c & 0xE0) == 0xC0) { w += 16 * scale; s += 2; }
    else if ((c & 0xF0) == 0xE0) { w += 16 * scale; s += 3; }
    else s++;
  }
  return w;
}

void drawCJKTextCentered(int cx, int y, const char *s, uint16_t color, int scale) {
  drawCJKText(cx - cjkTextWidth(s, scale) / 2, y, s, color, scale);
}

void lfbFill(uint16_t c) {
  uint16_t *p = lfb;
  for (int i = 0; i < 240 * 135; i++) *p++ = c;
}

void lfbRect(int16_t x, int16_t y, int16_t w, int16_t h, uint16_t c) {
  int16_t x1 = x + w - 1, y1 = y + h - 1;
  if (x1 < 0 || y1 < 0 || x >= 240 || y >= 135) return;
  if (x < 0) x = 0;
  if (y < 0) y = 0;
  if (x1 >= 240) x1 = 239;
  if (y1 >= 135) y1 = 134;
  for (int row = y; row <= y1; row++) {
    uint16_t *p = &lfb[row * 240 + x];
    for (int col = x; col <= x1; col++) *p++ = c;
  }
}

// ---- drawing primitives for programmatic icons ----
void drawHLine(int x0, int x1, int y, uint16_t c) {
  if (x0 > x1) { int t = x0; x0 = x1; x1 = t; }
  for (int x = x0; x <= x1; x++) lfbSet(x, y, c);
}

void drawLine(int x0, int y0, int x1, int y1, uint16_t c) {
  int dx = abs(x1 - x0), sx = x0 < x1 ? 1 : -1;
  int dy = -abs(y1 - y0), sy = y0 < y1 ? 1 : -1;
  int err = dx + dy;
  for (;;) {
    lfbSet(x0, y0, c);
    if (x0 == x1 && y0 == y1) break;
    int e2 = 2 * err;
    if (e2 >= dy) { err += dy; x0 += sx; }
    if (e2 <= dx) { err += dx; y0 += sy; }
  }
}

void fillTriangle(int x0, int y0, int x1, int y1, int x2, int y2, uint16_t c) {
  // sort vertices by y
  if (y0 > y1) { int t; t=x0;x0=x1;x1=t; t=y0;y0=y1;y1=t; }
  if (y0 > y2) { int t; t=x0;x0=x2;x2=t; t=y0;y0=y2;y2=t; }
  if (y1 > y2) { int t; t=x1;x1=x2;x2=t; t=y1;y1=y2;y2=t; }
  float dx02 = (y2 > y0) ? (float)(x2 - x0) / (y2 - y0) : 0;
  float dx01 = (y1 > y0) ? (float)(x1 - x0) / (y1 - y0) : 0;
  float dx12 = (y2 > y1) ? (float)(x2 - x1) / (y2 - y1) : 0;
  float xa = (float)x0, xb = (float)x0;
  for (int y = y0; y <= y2; y++) {
    int xL = (int)xa, xR = (int)xb;
    if (xL > xR) { int t = xL; xL = xR; xR = t; }
    drawHLine(xL, xR, y, c);
    xa += dx02;
    xb += (y < y1) ? dx01 : dx12;
  }
}

void drawArc(int cx, int cy, int r, float a0deg, float a1deg, uint16_t c) {
  int steps = 20;
  float px = 0, py = 0;
  for (int i = 0; i <= steps; i++) {
    float a = (a0deg + (a1deg - a0deg) * i / steps) * 3.14159f / 180.0f;
    float nx = cx + r * cos(a), ny = cy + r * sin(a);
    if (i) drawLine((int)px, (int)py, (int)nx, (int)ny, c);
    px = nx; py = ny;
  }
}

