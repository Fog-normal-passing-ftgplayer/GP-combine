void drawLever() {
  // big ring + a blue dot that follows the dpad direction
  int cx = lx(USER_LEVER_X), cy = ly(USER_LEVER_Y);
  drawRing(cx, cy, lr(USER_LEVER_RING), COL_RING);
  int dx = 0, dy = 0;
  uint8_t d = lastDpad;
  if (d & 0x01) dy -= lr(8); // UP
  if (d & 0x02) dy += lr(8); // DOWN
  if (d & 0x04) dx -= lr(8); // LEFT
  if (d & 0x08) dx += lr(8); // RIGHT
  drawDisc(cx + dx, cy + dy, lr(USER_LEVER_KNOB), ACC_SETTINGS);
}

void drawButtonLayout() {
  uint16_t b = lastButtons;
  uint8_t d = lastDpad;
  int layout = histOpts[1].value;
  if (layout == 0) {                    // 街机: lever
    drawLever();
  } else if (layout == 1) {             // HITBOX
    for (int i = 0; i < 4; i++) drawLayoutEntry(HITBOX_MOVE[i], b, d);
  } else if (layout == 2) {             // WASD
    for (int i = 0; i < 4; i++) drawLayoutEntry(WASD_MOVE[i], b, d);
  } else if (layout == 3) {             // 自定义: PC 向导生成的布局
#if defined(USER_LAYOUT)
    if (USER_SHOW_LEVER) {
      drawLever();                       // 摇杆捕获 D-Pad，开启时不再画移动键
    } else {
      for (int i = 0; i < (int)(sizeof(USER_MOVE) / sizeof(USER_MOVE[0])); i++)
        drawLayoutEntry(USER_MOVE[i], b, d);
    }
#else
    for (int i = 0; i < 4; i++) drawLayoutEntry(HITBOX_MOVE[i], b, d);
#endif
  } else {                              // fallback -> HITBOX
    for (int i = 0; i < 4; i++) drawLayoutEntry(HITBOX_MOVE[i], b, d);
  }
  // 右侧按键：预设用内置布局，自定义用 PC 向导生成的布局
#if defined(USER_LAYOUT)
  if (layout == 3) {
    for (int i = 0; i < (int)(sizeof(USER_CLUSTER) / sizeof(USER_CLUSTER[0])); i++)
      drawLayoutEntry(USER_CLUSTER[i], b, d);
  } else {
    for (int i = 0; i < 8; i++) drawLayoutEntry(RIGHT_CLUSTER[i], b, d);
  }
#else
  for (int i = 0; i < 8; i++) drawLayoutEntry(RIGHT_CLUSTER[i], b, d);
#endif
}

void pushHist(const char *label) {
  if (!histOpts[0].value) return; // input history disabled
  strncpy(histLabels[histHead], label, 2);
  histLabels[histHead][2] = 0;
  histHead = (histHead + 1) % HIST_MAX;
  if (histCount < HIST_MAX) histCount++;
  redrawNeeded = true;
}

void drawInputHistory() {
  if (!histOpts[0].value) return;
  int x = 6;
  for (int i = 0; i < histCount; i++) {
    int idx = (histHead - histCount + i + HIST_MAX) % HIST_MAX; // oldest first
    bool newest = (i == histCount - 1);
    drawTextBig(x, 124, histLabels[idx], newest ? COL_HI : RGB565(130,140,155), 1);
    x += (int)strlen(histLabels[idx]) * 4 + 6;
    if (x > 216) break;
  }
}

